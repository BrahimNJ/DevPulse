{
  "name": "devpulse",
  "version": "0.6.0",
  "private": true,
  "description": "Analytics for public GitHub repositories.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrahimNJ/DevPulse.git"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint-cli2",
    "prepare": "husky",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose",
    "test": "node --test \"src/**/*.test.ts\" \"infra/**/*.test.mjs\"",
    "devpulse": "node src/cli/bin.ts",
    "web": "node src/server/dev.ts",
    "check": "npm run format:check && npm run lint && npm run lint:md && npm run typecheck && npm test",
    "build": "vite build",
    "start": "node src/server/main.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "smol-toml": "1.9.1"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
